  "description": "NestJS Backend for Tohay Kids E-Commerce Platform",
  "author": "Tohay Kids Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
